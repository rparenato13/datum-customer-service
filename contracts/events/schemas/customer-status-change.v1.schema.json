{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datum:events:customer-status-change:v1",
  "title": "CUSTOMER_STATUS_CHANGE v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "customerId", "status", "expectedVersion"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "eventType": {"const": "CUSTOMER_STATUS_CHANGE"},
    "schemaVersion": {"type": "integer", "const": 1},
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 27,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "customerId": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "status": {"type": "string", "enum": ["ACTIVE", "INACTIVE"]},
    "expectedVersion": {"type": "integer", "minimum": 0, "maximum": 9223372036854775806}
  }
}
