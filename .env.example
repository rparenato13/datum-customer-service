# Somente demonstração local. Não reutilizar estas senhas em produção.
# Copie para .env; o arquivo .env é ignorado pelo Git.
POSTGRES_PORT=15432
POSTGRES_ADMIN_PASSWORD=datum_admin_local_only
CUSTOMER_DB_PASSWORD=customer_local_only
# Variáveis para execução do customer-service no host (exportar no terminal/IDE).
CUSTOMER_DB_URL=jdbc:postgresql://localhost:15432/customer_db
CUSTOMER_DB_USERNAME=customer_app
NOTIFICATION_DB_PASSWORD=notification_local_only

# Keycloak local: novos valores têm defaults de demonstração no Compose.
KEYCLOAK_PORT=18090
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_local_only
KEYCLOAK_DEMO_USER_PASSWORD=user_local_only
KEYCLOAK_DEMO_ADMIN_PASSWORD=admin_local_only

# Resource Server no host; em container use a URL interna do JWKS.
CUSTOMER_JWT_ISSUER_URI=http://localhost:18090/realms/datum
CUSTOMER_JWT_JWK_SET_URI=http://localhost:18090/realms/datum/protocol/openid-connect/certs
CUSTOMER_JWT_AUDIENCE=customer-api

# Provedor de Score simulado; default no Compose preserva o .env existente.
WIREMOCK_PORT=18082

# Cliente de Score no host; em container use http://wiremock:8080.
SCORE_BASE_URL=http://localhost:18082
SCORE_CONNECT_TIMEOUT_MS=500
SCORE_READ_TIMEOUT_MS=1000
SCORE_MAX_ATTEMPTS=2
SCORE_RETRY_DELAY_MS=100

# RabbitMQ: credenciais locais distintas das contas de banco e do Keycloak.
RABBITMQ_AMQP_PORT=15673
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_ADMIN_PASSWORD=rabbitmq_admin_local_only
CUSTOMER_RABBITMQ_PASSWORD=customer_rabbitmq_local_only
NOTIFICATION_RABBITMQ_PASSWORD=notification_rabbitmq_local_only
STATUS_PUBLISHER_RABBITMQ_PASSWORD=status_publisher_local_only

# Publicacao do outbox no host; em container use rabbitmq:5672.
CUSTOMER_RABBITMQ_HOST=localhost
CUSTOMER_RABBITMQ_PORT=15673
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_POLL_DELAY_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_CONFIRM_TIMEOUT_MS=5000
OUTBOX_LEASE_MS=30000
